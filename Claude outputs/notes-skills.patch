+.col-pj-name { min-width: 330px; max-width: 480px; padding: 6px 10px 7px 8px !important; }
+tr.pj-client-row td {
+  background: var(--surface-page); font-weight: 700; font-size: 11.5px;
+  letter-spacing: 0.02em; color: var(--text-primary); padding: 6px 8px !important;
+  border-top: 1px solid var(--baseline);
+}
+tr.pj-client-row td:first-child { border-left: 4px solid var(--accent); }
+.pj-client-name { font-weight: 700; font-size: 12.5px; text-decoration: underline;
+  text-decoration-color: var(--gridline); text-underline-offset: 2px; }
+.pj-client-toggle { display: inline; width: auto; }
+.pj-client-toggle:hover .pj-client-name { text-decoration-color: var(--accent); color: var(--accent); }
+tr.pj-client-row.pj-open .pj-caret { transform: rotate(90deg) translateX(1px); border-left-color: var(--accent); }
+.pj-indent-proj { padding-left: 22px !important; }
+.pj-cell-client { background: color-mix(in srgb, var(--accent) 20%, transparent); font-weight: 700; }
+.pj-cell-client .pj-open-tag { color: color-mix(in srgb, var(--status-serious) 80%, var(--text-primary)); }
+table.projects-grid tr.pj-row[hidden] { display: none !important; }
+tr.pj-client-row td .count-chip { margin-left: 4px; font-weight: 600; }
+.pj-chip-open { background: color-mix(in srgb, var(--status-warning) 30%, transparent); color: var(--text-primary); }
+tr.pj-row td { border-bottom: 1px solid var(--gridline); }
+tr.pj-row.pj-open td { border-bottom: none; }
+.pj-toggle {
+  display: block; width: 100%; text-align: left; background: none; border: none;
+  padding: 0; font: inherit; cursor: pointer; color: var(--text-primary);
+}
+.pj-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
+.pj-name { font-weight: 700; font-size: 12.5px; text-decoration: underline;
+  text-decoration-color: var(--gridline); text-underline-offset: 2px; }
+.pj-toggle:hover .pj-name { text-decoration-color: var(--accent); color: var(--accent); }
+.pj-caret {
+  display: inline-block; width: 0; height: 0; margin-right: 7px; vertical-align: 2px;
+  border-left: 5px solid var(--muted-ink); border-top: 4px solid transparent;
+  border-bottom: 4px solid transparent; transition: transform 0.12s ease-out;
+}
+tr.pj-open .pj-caret { transform: rotate(90deg) translateX(1px); border-left-color: var(--accent); }
+tr.pj-detail td { border-bottom: none; padding-top: 2px; padding-bottom: 2px; }
+tr.pj-detail:has(+ tr.pj-client-row) td,
+tr.pj-detail:has(+ tr.pj-grand-row) td { border-bottom: 1px solid var(--gridline); }
+.pj-indent { padding-left: 26px !important; }
+.pj-person { font-weight: 600; font-size: 12px; }
+.pj-level {
+  display: inline-block; font-size: 9.5px; font-weight: 600; margin-left: 6px;
+  background: var(--gridline); color: var(--text-secondary); border-radius: 3px;
+  padding: 0 5px; vertical-align: 1px; white-space: nowrap;
+}
+.pj-title { font-size: 10.5px; color: var(--text-secondary); }
+.pj-title-none { font-style: italic; color: var(--muted-ink); }
+.pj-open-role { font-weight: 600; font-size: 12px; color: var(--text-primary); }
+.pj-open-badge {
+  display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: 0.04em;
+  margin-left: 6px; padding: 0 5px; border-radius: 3px; vertical-align: 1px;
+  background: color-mix(in srgb, var(--status-warning) 34%, transparent); color: var(--text-primary);
+}
+.pj-cell {
+  border-radius: 5px; padding: 2px 4px; min-width: 62px;
+  font-variant-numeric: tabular-nums; line-height: 1.3;
+}
+.pj-h { font-size: 12px; }
+.pj-cell-empty { color: var(--muted-ink); font-size: 11px; }
+.pj-cell-total { background: color-mix(in srgb, var(--accent) 13%, transparent); font-weight: 700; }
+.pj-cell-staff { color: var(--text-secondary); }
+.pj-cell-open { background: color-mix(in srgb, var(--status-warning) 22%, transparent); font-weight: 700; }
+.pj-cell-grand { font-weight: 700; }
+.pj-open-tag {
+  display: block; font-size: 8.5px; font-weight: 700; line-height: 1.25;
+  color: var(--text-secondary); white-space: nowrap;
+}
+.pj-cell-total .pj-open-tag { color: color-mix(in srgb, var(--status-serious) 80%, var(--text-primary)); }
+tr.pj-grand-row td {
+  font-weight: 700; background: var(--surface-page);
+  border-top: 1px solid var(--baseline); border-bottom: none;
+}
+tr.pj-grand-row td:first-child {
+  font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em;
+  color: var(--text-secondary); padding-left: 8px;
+}
+@media (max-width: 760px) { .col-pj-name { min-width: 220px; } }
+.pj-h-zero { color: var(--muted-ink); font-weight: 400; }
+
+/* Open-role suggestions from current staff (added Sep 14 2026) */
+.demand-fits { color: var(--text-primary); font-size: 11.5px; line-height: 1.45; }
+.demand-fits > b { color: var(--text-secondary); font-weight: 650; }
+.fit-list { list-style: none; margin: 5px 0 0; padding: 0; display: grid; gap: 5px; }
+.fit-card {
+  display: grid; grid-template-columns: 16px minmax(0, 168px) 30px minmax(0, 1fr);
+  align-items: baseline; gap: 8px;
+  padding: 5px 8px; border: 1px solid var(--border); border-radius: 6px;
+  background: var(--surface-page);
+}
+.fit-rank { color: var(--muted-ink); font-variant-numeric: tabular-nums; }
+.fit-name { font-weight: 650; }
+.fit-score {
+  font-variant-numeric: tabular-nums; text-align: center; border-radius: 4px;
+  padding: 1px 0; font-size: 10.5px; font-weight: 650; color: #fff;
+}
+.fit-cover-full { background: var(--status-good); }
+.fit-cover-part { background: var(--status-warning); color: #21170a; }
+.fit-cover-thin { background: var(--muted-ink); }
+.fit-whys { color: var(--text-secondary); min-width: 0; }
+.fit-why { display: inline; }
+.fit-why + .fit-why::before { content: " · "; color: var(--muted-ink); }
+.fit-none { margin-top: 5px; color: var(--text-secondary); font-style: italic; }
+@media (max-width: 760px) {
+  .fit-card { grid-template-columns: 16px minmax(0, 1fr) 30px; }
+  .fit-whys { grid-column: 2 / -1; }
+}
+.fits-legend { display: block; margin: 2px 0 10px; line-height: 1.5; max-width: 96ch; }
+.fits-legend .fit-score { display: inline-block; width: 18px; vertical-align: middle; }
+.est-chip { display: inline-block; font-size: 8.5px; font-weight: 700; background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); border-radius: 3px; padding: 0 3px; margin-left: 3px; vertical-align: 1px; white-space: nowrap; cursor: help; }
+.util-badge i { font-style: normal; font-size: 9px; opacity: 0.75; }
+.chip-norec { background: color-mix(in srgb, var(--status-serious) 22%, transparent); color: var(--text-primary); font-weight: 700; }
+/* demand that exists on this page but not in Salesforce - hours taken off a
+   consultant here. Marked so nobody reads it as ordinary pipeline demand. */
+.chip-vacated { background: color-mix(in srgb, var(--status-warning) 30%, transparent);
+  color: var(--text-primary); font-weight: 700;
+  border: 1px dashed color-mix(in srgb, var(--status-warning) 70%, transparent); }
+
+/* Recruiting update callout (Mark, Sep 14 2026: make it jump out) */
+.demand-update {
+  font-style: normal; color: var(--text-primary); font-size: 11.5px; line-height: 1.45;
+  background: color-mix(in srgb, var(--status-warning) 14%, transparent);
+  border-left: 3px solid var(--status-warning);
+  border-radius: 0 6px 6px 0; padding: 5px 10px; margin: 2px 0 1px;
+}
+.demand-update b {
+  color: color-mix(in srgb, var(--status-serious) 70%, var(--text-primary));
+  font-weight: 700; letter-spacing: 0.01em;
+}
+
+/* Inline agenda editing (Mark, Sep 14 2026). Mirrors AGENDA_CSS in agenda_section.py,
+   which build_dashboard does not read - the stylesheet carries its own copy. */
+/* The row keeps its default list-item layout - display:flex on an <li> drops the
+   ordered-list number in Chromium - so the controls stay floated and the editor is
+   sized against the row instead. */
+.agenda-text { cursor: text; border-bottom: 1px dotted transparent; }
+.agenda-text:hover { border-bottom-color: var(--muted-ink); }
+.agenda-text:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
+.agenda-edit {
+  width: calc(100% - 150px); border: 1px solid var(--accent); border-radius: 5px;
+  background: var(--surface-page); color: var(--text-primary); font: inherit;
+  font-size: 13px; padding: 2px 7px; box-sizing: border-box; vertical-align: middle;
+}
+@media (max-width: 700px) { .agenda-edit { width: calc(100% - 40px); } }
+.wk-proj-rem { color: var(--diverge-under); text-decoration: line-through; text-decoration-thickness: 1px; }
+.rem-tag { background: color-mix(in srgb, var(--status-critical) 22%, transparent); color: var(--text-primary); }
+tr.demand-prop-role td { border-bottom: 1px solid var(--gridline); padding-top: 6px; }
+tr.demand-prop-role .demand-role { color: var(--accent); }
+.wk-demand-prop { background: color-mix(in srgb, var(--accent) 20%, transparent); border: 1px dashed var(--accent); }
+tr.demand-prop-total td { color: var(--accent); }
+
+/* ================= staffing app layer: comments, actions, allocations ====== */
+.ct-btn {
+  display: inline-flex; align-items: center; gap: 3px; vertical-align: 1px;
+  background: none; border: 1px solid var(--gridline); border-radius: 10px;
+  color: var(--muted-ink); cursor: pointer; font: inherit; font-size: 10px;
+  font-weight: 700; line-height: 1.6; padding: 0 6px; margin-left: 6px;
+}
+.ct-btn:hover { border-color: var(--accent); color: var(--accent); }
+.ct-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+.ct-btn-ico { font-size: 10px; font-weight: 400; }
+.ct-btn.ct-has { border-color: var(--accent); color: var(--accent);
+  background: color-mix(in srgb, var(--accent) 10%, transparent); }
+.ct-btn.ct-st-watch { border-color: var(--status-warning); color: var(--text-primary);
+  background: color-mix(in srgb, var(--status-warning) 22%, transparent); }
+.ct-btn.ct-st-action { border-color: var(--status-critical); color: #fff;
+  background: var(--status-critical); }
+.ct-btn.ct-st-resolved { border-color: var(--status-good); color: var(--status-good);
+  background: color-mix(in srgb, var(--status-good) 12%, transparent); }
+.sec-head .ct-btn { font-size: 11px; vertical-align: 2px; }
+.ub-row .ct-btn { margin-left: 4px; }
+.ub-row { grid-template-columns: 200px 1fr 58px auto; }
+@media (max-width: 760px) { .ub-row { grid-template-columns: 130px 1fr 52px auto; } }
+
+/* ---- inline thread mount (open roles + capacity commentary) ---- */
+.ct-mount { border: 1px dashed var(--gridline); border-radius: 7px; padding: 5px 9px 6px;
+  background: var(--surface-page); }
+.ct-mount-empty { color: var(--muted-ink); font-size: 11.5px; font-style: italic; }
+.ct-mount-line { font-size: 11.5px; color: var(--text-primary); margin-bottom: 2px; }
+.ct-mount-line:last-child { margin-bottom: 0; }
+.ct-mount-meta { color: var(--muted-ink); font-size: 10.5px; font-style: normal; }
+.ct-mount button.ct-open { background: none; border: none; padding: 0; margin-top: 3px;
+  font: inherit; font-size: 11px; font-weight: 600; color: var(--accent); cursor: pointer;
+  text-decoration: underline; text-underline-offset: 2px; }
+.section-note.ct-mount { margin: 0 0 12px; }
+
+/* ---- proposed allocation overlay ---- */
+.wk-proj-prop { color: var(--accent); font-weight: 700; font-style: italic; }
+.wk-cell.wk-prop { box-shadow: inset 3px 0 0 var(--accent), 0 0 0 1px var(--accent) inset; }
+.prop-chip { display: inline-block; font-size: 10px; font-weight: 700; border-radius: 9px;
+  padding: 1px 8px; margin: 3px 4px 0 0; white-space: nowrap;
+  background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent);
+  border: 1px dashed var(--accent); }
+tr.cap-prop-row td { color: var(--accent); font-weight: 600; }
+tr.cap-prop-gap-row td { font-weight: 700; background: var(--surface-page); }
+.cap-prop-note { font-size: 11px; color: var(--muted-ink); margin-top: 6px; font-style: italic; }
+
+/* ================= meeting log panel ====================================== */
+.mlog { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px;
+  padding: 14px 18px 16px; margin-bottom: 16px; }
+.mlog [hidden] { display: none !important; }
+.mlog .sec-head { margin: -14px -18px 12px !important; padding: 9px 18px; }
+.mlog-sub { font-size: 11.5px; font-weight: 500; color: var(--muted-ink); margin-left: 8px; }
+.mlog-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
+.mlog-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
+.mlog-tab { border: 1px solid var(--border); background: var(--surface-page);
+  color: var(--text-secondary); font: inherit; font-size: 12.5px; font-weight: 600;
+  border-radius: 7px; padding: 5px 12px; cursor: pointer; }
+.mlog-tab:hover { color: var(--text-primary); }
+.mlog-tab-active { background: var(--accent); border-color: var(--accent); color: #fff; }
+.mlog-tab-active:hover { color: #fff; }
+.mlog-tab .n { font-variant-numeric: tabular-nums; opacity: 0.8; }
