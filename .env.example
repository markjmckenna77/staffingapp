# ---- Auth.js (Microsoft Entra ID) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# From the Entra app registration (Azure portal > App registrations)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Cleartelligence tenant id (GUID). Restricts sign-in to this tenant only.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Comma-separated list of allowed email domains
ALLOWED_EMAIL_DOMAINS=cleartelligence.com
# Only needed locally; Vercel sets this automatically
# AUTH_URL=http://localhost:3000

# ---- Snowflake (read-only service account, key-pair auth) ----
SNOWFLAKE_ACCOUNT=            # org-account form, e.g. AHOWHJS-ET65504
SNOWFLAKE_USER=               # service user, e.g. SVC_STAFFING_APP
SNOWFLAKE_ROLE=               # STAFFING_APP_RO
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=PRD_BI_SUITE
SNOWFLAKE_SCHEMA=STAFFING_APP   # cost-free views, see snowflake/setup.sql
# PEM private key, newlines escaped as \n (paste as a single line in Vercel)
SNOWFLAKE_PRIVATE_KEY=
# Optional passphrase if the key is encrypted
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- Shared store (meeting log, agenda, action items, allocations) - Postgres ----
# Vercel > Storage > Create Database > Postgres (Neon) > Connect to this project sets this.
DATABASE_URL=
# Who may run /admin/import and write allocations to NetSuite (comma-separated)
ADMIN_EMAILS=mark.mckenna@cleartelligence.com
APPROVER_EMAILS=
# Bearer token the scheduled Granola import uses for POST /api/meeting-log/import
# Generate with: openssl rand -hex 24
IMPORT_TOKEN=

# ---- NetSuite (system of record for staffing: Resource Allocations) ----
# Setup > Integration > Manage Integrations > New: Token-Based Authentication on -> consumer key/secret.
# Setup > Users/Roles > Access Tokens > New (integration user + a role with Resource Allocations full,
# Employees/Projects view, REST Web Services, SuiteAnalytics Workbook, Log in using Access Tokens).
NS_ACCOUNT_ID=                # as shown in Setup > Company Information, e.g. 1234567 or 1234567_SB1
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=
NS_WRITE_ENABLED=false        # "true" creates/updates Resource Allocations; otherwise lookups only (dry run)
# Optional overrides
# NS_ALLOCATION_ROLE_FIELD=custevent_ct_allocation_role
# NS_ALLOCATION_TYPE_HARD_ID=1
# NS_REQUESTED_BY_ID=         # employee internal id stamped as "requested by" on new allocations

# ---- Greenhouse (Harvest API) - live recruiting picture for Recruiting Activity ----
# Configure > Dev Center > API Credential Management > Create New API Key: type Harvest;
# permissions (GET only): Jobs, Applications, Candidates, Users, Job Stages. Basic auth, key as username.
GREENHOUSE_API_KEY=
# Job custom-field keys, if they differ (GET /api/recruiting?discover=1 as an admin lists them)
# GH_FIELD_CLIENT=client
# GH_FIELD_PORTFOLIO=portfolio
# GH_FIELD_START=anticipated_start_date
# GH_FIELD_NOTES=status_notes
# GH_FIELD_EMP=employment_type
# GH_INTERVIEW_STAGES=interview|screen|onsite|panel|team|final|technical|case
# GH_EXCLUDE_JOBS=^\s*internal\b      # jobs left out of the sync (Mark: anything starting with "Internal")
