# ---- Auth.js (Microsoft Entra ID) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# From the Entra app registration (Azure portal > App registrations)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Cleartelligence tenant id (GUID). Restricts sign-in to this tenant only.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Comma-separated list of allowed email domains
ALLOWED_EMAIL_DOMAINS=cleartelligence.com
# Only needed locally; Vercel sets this automatically
# AUTH_URL=http://localhost:3000

# ---- Snowflake (read-only service account, key-pair auth) ----
SNOWFLAKE_ACCOUNT=            # org-account form, e.g. AHOWHJS-ET65504
SNOWFLAKE_USER=               # service user, e.g. SVC_STAFFING_APP
SNOWFLAKE_ROLE=               # STAFFING_APP_RO
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=PRD_BI_SUITE
SNOWFLAKE_SCHEMA=STAFFING_APP   # cost-free views, see snowflake/setup.sql
# PEM private key, newlines escaped as \n (paste as a single line in Vercel)
SNOWFLAKE_PRIVATE_KEY=
# Optional passphrase if the key is encrypted
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- Shared store (meeting log, agenda, action items, allocations) - Postgres ----
# Vercel > Storage > Create Database > Postgres (Neon) > Connect to this project sets this.
DATABASE_URL=
# Who may run /admin/import and mark allocations entered in Certinia (comma-separated)
ADMIN_EMAILS=mark.mckenna@cleartelligence.com
APPROVER_EMAILS=
# Bearer token the scheduled Granola import uses for POST /api/meeting-log/import
# Generate with: openssl rand -hex 24
IMPORT_TOKEN=

# ---- Certinia PSA (Salesforce) - real allocations; leave empty until the integration user exists ----
SF_LOGIN_URL=                 # https://<mydomain>.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v61.0
SF_ENTER_ENABLED=false        # "true" performs writes; otherwise lookups only (dry run)
